# Copy to config/.env and fill in real values. Never commit config/.env.

# --- AI provider ---
# "gemini" or "openrouter"
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Job-discovery search engines (only the ones you use need a value) ---
GOOGLE_SEARCH_API_KEY=
SEARCH_ENGINE_ID=
PERPLEXITY_API_KEY=
SERPAPI_KEY=
BRAVE_API_KEY=
SCRAPINGBEE_API_KEY=

# --- LaTeX compiler service ---
# Local dev: http://localhost:5000
# In-cluster (K8s): http://latex-compiler:5000
LATEX_COMPILER_URL=http://localhost:5000
