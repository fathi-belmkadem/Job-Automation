# Copy to config/.env and fill in real values. Never commit config/.env.

# Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=

# URL of the latex-self-hosted compiler service.
# Local dev: http://localhost:5000
# In-cluster (K8s): http://latex-compiler:5000
LATEX_COMPILER_URL=http://localhost:5000
